# Telegram Bot 推送配置（可选）
# TELEGRAM_ENABLED=true 启用推送，其他值或不设置则跳过
# 1. 与 @BotFather 对话创建 Bot，获取 Token
# 2. 与 Bot 发送一条消息，然后访问 https://api.telegram.org/bot<TOKEN>/getUpdates 获取 chat_id
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram 自动发布配置（可选）
# IG_ENABLED=true 启用发布，其他值或不设置则跳过
# 首次使用需先运行 python scripts/ig_login.py 完成登录
# IG_SESSION_PATH 可选，默认 ~/.instagram/session.json
IG_ENABLED=false
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_PATH=

# LLM API（节气内容与诗词模块，二选一必填）
# 支持 Grok、ChatGPT、DeepSeek 等 OpenAI 兼容 API

# 方式一：Grok（推荐，自动使用 https://api.x.ai/v1）
GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1   # 可选，默认即此值

# 方式二：OpenAI 或其他兼容服务
OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 可选，DeepSeek 填 https://api.deepseek.com
